# Database
POSTGRES_DB=tasktracker           # Name of the PostgreSQL database
POSTGRES_USER=postgres            # PostgreSQL username
POSTGRES_PASSWORD=postgres        # PostgreSQL password
DB_PORT=5432                      # Port to expose PostgreSQL on host

# Backend
JWT_SECRET=task-tracker-lite-secret-key  # Secret key for JWT signing
JWT_EXPIRES_IN=24h                # JWT token expiration time
PORT=3000                         # Backend API port

# Frontend
FRONTEND_PORT=5173                  # Frontend port on host
